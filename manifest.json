{
  "manifest_version": 3,
  "name": "조준경 - 유튜브 이탈 방지",
  "version": "0.1.0",
  "description": "유튜브 진입 시 목적을 선언하고, 목적과 무관한 영상 시청을 AI가 감지해 경고합니다.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/main.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/history-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "shared/schema.js",
        "shared/storage.js",
        "shared/selectors.js",
        "shared/report-view.js",
        "content/messaging.js",
        "content/ui.js",
        "content/log.js",
        "content/navigation.js",
        "content/session.js",
        "content/dwell-tracker.js",
        "content/shorts-block.js",
        "content/completion.js",
        "content/report-modal.js",
        "content/reason-flow.js",
        "content/judge-flow.js",
        "content/main.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
